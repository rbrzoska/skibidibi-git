{
  "name": "skibidibi-git",
  "version": "0.1.6",

  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "pnpm": "^11.7.0"
  },
  "scripts": {
    "start": "pnpm tauri dev",
    "dev": "pnpm tauri dev",
    "tauri": "tauri",
    "build": "pnpm --filter @skibidibi-git/desktop build",
    "lint": "pnpm --filter @skibidibi-git/desktop lint",
    "test": "pnpm --filter @skibidibi-git/desktop test",
    "test:tools": "node --test tools/*.test.mjs",
    "verify:release-notes": "node tools/current-release-notes.mjs --check",
    "verify:windows-release": "node tools/verify-windows-release-policy.mjs",
    "verify:microsoft-store": "node tools/verify-microsoft-store-release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
