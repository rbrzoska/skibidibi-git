{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skibidibi Git",
  "version": "0.1.0",
  "identifier": "com.rbrzoska.skibidibi-git",
  "build": {
    "beforeDevCommand": "pnpm --dir .. exec ng serve desktop",
    "beforeBuildCommand": "pnpm --dir .. exec ng build desktop",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/desktop/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Skibidibi Git",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.svg.png"]
  }
}
